#!/usr/bin/env bash
#
# Draws a Jukebox row onto the bottom of the game's own launcher, then starts
# the game.
#
# Set it as the title's Steam launch options:
#
#     /full/path/to/tools/steam-launch-wrapper %command%
#
# Steam replaces %command% with the real launch command, which this script runs
# unchanged and waits for - so the game starts exactly as before, and Steam
# keeps tracking it: play time, the overlay and the "In-Game" state your
# friends see all behave as they always did.
#
# The row waits for the launcher's window to appear, sits on its bottom frame
# so the two read as one window, and goes when the launcher goes - whether a
# game was picked or the window was simply closed.  A jukebox opened from it
# keeps playing, which is why the companion is started in its own session
# rather than killed on the way out.
#
# It does not replace the launcher.  The launcher is a Windows executable that
# runs before the game and reads no mod data, and ClientG.exe takes no
# game-selection argument, so a stand-in chooser could only hand off to the
# real one and would add a step rather than remove one.
#
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
jukebox="$here/cnc-jukebox"

log="${XDG_RUNTIME_DIR:-/tmp}/cnc-jukebox-companion.log"

if [ ! -x "$jukebox" ]; then
    echo "cnc-jukebox not found at $jukebox" >&2
    exec "$@"
fi

# Detached, so that music started from the row survives this script - and told
# our pid, so that it closes itself if the launcher window is never found.
#
# Its output goes to a file rather than nowhere: when the row fails to appear
# this is the only place that says why, and Steam shows none of it.
{
    echo "--- $(date '+%F %T') $jukebox --launcher-button"
} >"$log" 2>/dev/null || log=/dev/null

if command -v setsid >/dev/null 2>&1; then
    setsid "$jukebox" --launcher-button --launcher-pid $$ \
        </dev/null >>"$log" 2>&1 &
else
    "$jukebox" --launcher-button --launcher-pid $$ \
        </dev/null >>"$log" 2>&1 &
fi
companion=$!

if [ "$#" -gt 0 ]; then
    "$@"
else
    # Nothing to run: this is the "just show me the row" case.
    wait "$companion"
fi
