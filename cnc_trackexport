usage() {
    case "$(ui_lang)" in
        de) usage_de ;;
        *)  usage_en ;;
    esac
}

for arg in "$@"; do
    case "$arg" in
        -h|--help) usage; exit 0 ;;
    esac
done

if ! command -v python3 >/dev/null 2>&1; then
    case "$(ui_lang)" in
        de) echo "Fehler: python3 wird benoetigt." >&2 ;;
        *)  echo "Error: python3 is required." >&2 ;;
