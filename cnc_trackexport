def steam_roots():
    home = os.path.expanduser("~")
    xdg = os.environ.get("XDG_DATA_HOME") or os.path.join(home, ".local", "share")
    roots = [
        os.path.join(home, ".steam", "steam"),
        os.path.join(home, ".steam", "root"),
        os.path.join(home, ".steam", "debian-installation"),
        os.path.join(xdg, "Steam"),
        os.path.join(home, ".local", "share", "Steam"),
        os.path.join(home, ".var", "app", "com.valvesoftware.Steam",
                     ".local", "share", "Steam"),                       # Flatpak
        os.path.join(home, "snap", "steam", "common", ".local",
                     "share", "Steam"),                                 # Snap
    ]
    # Any further libraries are listed in libraryfolders.vdf.
    for r in list(roots):
        for vdf in (os.path.join(r, "steamapps", "libraryfolders.vdf"),
                    os.path.join(r, "config", "libraryfolders.vdf")):
            try:
                with open(vdf, encoding="utf-8", errors="replace") as f:
                    roots += re.findall(r'"path"\s+"([^"]+)"', f.read())
            except OSError:
                pass
    return roots


def soundtrack_dir(game_dir):
    """Where the game keeps user content, so the tracks sit with the game.

    Under Proton that is Documents/CnCRemastered inside the prefix, next to
    Mods, Save and Replays.  Steam leaves it alone on updates, unlike the
    install directory.  Falls back to the music folder, then to the working
    directory.
    """
    marker = os.path.join("steamapps", "common", "CnCRemastered")
    if game_dir and game_dir.endswith(marker):
        base = game_dir[:-len(marker)]
        docs = os.path.join(base, "steamapps", "compatdata", "1213210", "pfx",
                            "drive_c", "users", "steamuser", "Documents",
                            "CnCRemastered")
        if os.path.isdir(docs):
            return os.path.join(docs, "Soundtrack")
    music = os.environ.get("XDG_MUSIC_DIR") or os.path.expanduser("~/Music")
    if os.path.isdir(music):
        return os.path.join(music, "C&C Remastered Soundtrack")
    return "cnc_soundtrack"


def find_game_dir():
    env = os.environ.get("CNC_REMASTERED_DIR")
    if env:
        return env
    seen = set()
    for r in steam_roots():
        cand = os.path.join(r, "steamapps", "common", "CnCRemastered")
        if cand in seen:
            continue
        seen.add(cand)
        if os.path.isfile(os.path.join(cand, "Data", "MUSIC.MEG")):
            return cand
    return None


def have_encoder(name):
    try:
        out = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error",
                              "-encoders"], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL).stdout.decode("utf-8", "replace")
    except OSError:
        return False
    return re.search(r"^\s*\S+\s+%s\s" % re.escape(name), out, re.M) is not None


CTRL = dict.fromkeys(range(0x20))


def safe_name(title, portable):
    # No filename may hold a "/".  U+2215 DIVISION SLASH looks identical and
    # is allowed on ext4, NTFS and FAT32 alike, so the name still reads as the
    # one in the jukebox.  The "title" tag keeps the real slash either way.
    n = title.replace("/", "∕").replace("\\", "-")
    n = n.translate(CTRL)
    if portable:
        n = n.replace("∕", "-").replace("–", "-").replace("—", "-")
        n = re.sub(r'[:*?"<>|]', "", n)
        n = n.encode("ascii", "replace").decode("ascii").replace("?", "")
    n = re.sub(r"\s+", " ", n).strip().rstrip(". ")
    # A filename rather than a message, so it stays put whatever the locale
    # is - an export should not be named differently on a German machine.
    return n or "Untitled"


def fetch_cover():
    try:
        req = urllib.request.Request(COVER_URL, headers={"User-Agent": "cnc_trackexport"})
        with urllib.request.urlopen(req, timeout=30) as r:
            data = r.read()
        if not data.startswith(b"\xff\xd8"):
            raise ValueError(_("not_jpeg"))
        return data
    except Exception as e:
        sys.stderr.write(_("cover_failed", e))
        return None


class Cover(object):
    """Holds the artwork in memory and hands ffmpeg /dev/fd/N for it.

    That way no temporary file is created anywhere.  Each ffmpeg opens the
    path itself and so gets its own file position, which keeps parallel jobs
    out of each other's way.  Without memfd_create (Python < 3.8) it falls
    back to a file in the system temp directory, never the output one.
    """

    def __init__(self, data):
        self.fd = None
        self.path = None
        self._tmpdir = None
        if not data:
            return
        if hasattr(os, "memfd_create"):
            self.fd = os.memfd_create("cnc_cover")
            os.write(self.fd, data)
            os.lseek(self.fd, 0, os.SEEK_SET)
            os.set_inheritable(self.fd, True)
            self.path = "/dev/fd/%d" % self.fd
        else:
            self._tmpdir = tempfile.mkdtemp(prefix="cnc_trackexport.")
            self.path = os.path.join(self._tmpdir, "cover.jpg")
            with open(self.path, "wb") as f:
                f.write(data)

    @property
    def pass_fds(self):
        return (self.fd,) if self.fd is not None else ()

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None
        if self._tmpdir:
            shutil.rmtree(self._tmpdir, ignore_errors=True)
            self._tmpdir = None


# ---------------------------------------------------------------------------
def build_command(track, dest, fmt, cover):
    # The WAV arrives on stdin and the artwork through /dev/fd/N, both out of
    # memory, so nothing is written in between.
    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
           "-f", "wav", "-i", "pipe:0"]
    if cover.path:
        cmd += ["-i", cover.path, "-map", "0:a", "-map", "1:v",
                "-c:v", "copy", "-disposition:v", "attached_pic"]
    else:
        cmd += ["-map", "0:a"]

    if fmt == "mp3":
        # Measured against the originals: below 32 kHz LAME drops into
        # MPEG-2 Layer III, which is capped at 160 kbit/s at 22.05 kHz and
        # also rolls off around 9.9 kHz - losing over 80 % of the energy in
        # the top band.  Brought to 44.1 kHz it encodes as MPEG-1 and renders
        # the source in full.  Hence 44.1 kHz / 320 kbit/s throughout, the
        # Classic tracks included.
        cmd += ["-c:a", "libmp3lame", "-ar", str(TARGET_RATE), "-b:a", "320k",
                "-id3v2_version", "3"]
    else:
        # FLAC is lossless, so the original sample rate stays.
        cmd += ["-c:a", "flac", "-compression_level", "8"]

    artist = ("Frank Klepacki & The Tiberian Sons"
              if "tiberian sons" in track["title"].lower() else ALBUM_ART)
    grouping = " ".join(x for x in (track["game"], track["type"]) if x)

    cmd += ["-metadata", "title=%s" % track["title"],
            "-metadata", "artist=%s" % artist,
            "-metadata", "album_artist=%s" % ALBUM_ART,
            "-metadata", "album=%s" % ALBUM,
            "-metadata", "genre=Soundtrack",
            "-metadata", "date=%s" % YEAR,
            "-metadata", "track=%d/%d" % (track["no"], track["total"])]
    if grouping:
        cmd += ["-metadata", "grouping=%s" % grouping,
                "-metadata", "comment=%s" % grouping]
    cmd.append(dest)
    return cmd


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("-o", "--out")
    ap.add_argument("-g", "--game")
    ap.add_argument("-f", "--format", default="mp3", choices=("mp3", "flac", "wav"))
    ap.add_argument("-l", "--lang", default="EN-US")
    ap.add_argument("-j", "--jobs", type=int, default=min(os.cpu_count() or 4, 16))
    ap.add_argument("--no-cover", action="store_true")
    ap.add_argument("--portable", action="store_true")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--list", action="store_true")
    args = ap.parse_args()
    args.jobs = max(1, args.jobs)

    game = args.game or find_game_dir()
    if not game:
        die(_("no_game"))
    if not args.out:
        args.out = soundtrack_dir(game)
    data_dir = os.path.join(game, "Data")
    music_meg = os.path.join(data_dir, "MUSIC.MEG")
    config_meg = os.path.join(data_dir, "CONFIG.MEG")
    for p in (music_meg, config_meg):
        if not os.path.isfile(p):
            die(_("no_file", p))

    if args.format in ("mp3", "flac") and not args.list:
        if not shutil.which("ffmpeg"):
            die(_("no_ffmpeg"))
        enc = "libmp3lame" if args.format == "mp3" else "flac"
        if not have_encoder(enc):
            die(_("no_encoder", enc))

    # --- the jukebox names, out of the game data --------------------------
    print(_("reading"))
    config = Meg(config_meg)

    raw_xml = config.find(XML_PATH)
    if raw_xml is None:
        die(_("no_xml", XML_PATH))
    jukebox = parse_jukebox(raw_xml.decode("utf-8", "replace"))

    raw_loc = config.find(LOC_PATH.format(args.lang.upper()))
    if raw_loc is None:
        langs = sorted(n.rsplit("_", 1)[-1][:-4] for n, _, _ in config.entries
                       if n.upper().startswith("DATA\\TEXT\\MASTERTEXTFILE_"))
        die(_("no_lang", args.lang, ", ".join(langs)))
    text = parse_loc(raw_loc)

    # --- the audio --------------------------------------------------------
    music = Meg(music_meg)
    tracks, unmatched = [], []
    for name, size, offset in music.entries:
        base = name.split("\\")[-1]
        info = jukebox.get(base.lower())
        if info and info["text_id"] in text:
            # In the UI framework "&&" is the escape for a single "&".
            title = text[info["text_id"]].replace("&&", "&")
            game_name, ttype, secs = info["game"], info["type"], info["secs"]
        else:
            title = os.path.splitext(base)[0].replace("_", " ").title()
            game_name = ttype = ""
            secs = 0
            unmatched.append(base)
        tracks.append({"title": title, "game": game_name, "type": ttype,
                       "size": size, "offset": offset, "src": base, "secs": secs})

    if unmatched:
        sys.stderr.write(_("unmatched", len(unmatched),
                             ", ".join(unmatched[:5])))

    # The jukebox sorts alphabetically, and the track numbers follow it.
    tracks.sort(key=lambda t: t["title"].lower())
    total = len(tracks)
    for i, t in enumerate(tracks, 1):
        t["no"] = i
        t["total"] = total

    if args.list:
        for t in tracks:
            print("%3d/%d  %-52s  [%s %s]  <- %s"
                  % (t["no"], total, t["title"], t["game"], t["type"], t["src"]))
        print(_("list_total", total))
        return 0

    try:
        os.makedirs(args.out, exist_ok=True)
    except OSError as e:
        die(_("no_mkdir", e))
    if not os.access(args.out, os.W_OK):
        die(_("no_write", os.path.abspath(args.out)))

    # Estimate the space needed before 200 encoders set off.
    secs = sum(t["secs"] for t in tracks) or 0
    if args.format == "mp3":
        need = secs * 40000                       # 320 kbit/s
    elif args.format == "flac":
        need = secs * TARGET_RATE * 2 * 0.6
    else:
        need = sum(t["size"] for t in tracks)
    try:
        free = shutil.disk_usage(args.out).free
        if need and free < need * 1.05:
            die(_("no_space", os.path.abspath(args.out),
                  free / 2**30, need / 2**30))
    except OSError:
        pass

    art = None
    if not args.no_cover and args.format != "wav":
        print(_("fetching"))
        art = fetch_cover()
    cover = Cover(art)

    print(_("exporting", total, os.path.abspath(args.out),
            args.format.upper(), args.jobs))

    lock = threading.Lock()
    state = {"n": 0, "done": 0, "skipped": 0, "failed": []}
    inflight = set()

    def work(t):
        stem = safe_name(t["title"], args.portable)
        dest = os.path.join(args.out, "%s.%s" % (stem, args.format))

        if os.path.exists(dest) and not args.force:
            with lock:
                state["n"] += 1
                state["skipped"] += 1
            return

        wav = music.read(t["offset"], t["size"])
        if len(wav) != t["size"] or not wav.startswith(b"RIFF"):
            with lock:
                state["n"] += 1
                state["failed"].append((t["title"], _("bad_riff")))
            return

        with lock:
            inflight.add(dest)
        try:
            if args.format == "wav":
                with open(dest, "wb") as f:
                    f.write(wav)
            else:
                cmd = build_command(t, dest, args.format, cover)
                proc = subprocess.run(cmd, input=wav, stdout=subprocess.PIPE,
                                      stderr=subprocess.PIPE,
                                      pass_fds=cover.pass_fds)
                if proc.returncode != 0:
                    if os.path.exists(dest):
                        os.remove(dest)
                    msg = proc.stderr.decode("utf-8", "replace").strip().splitlines()
                    with lock:
                        state["n"] += 1
                        state["failed"].append(
                            (t["title"], msg[-1] if msg else
                             _("ffmpeg_exit", proc.returncode)))
                    return
        finally:
            with lock:
                inflight.discard(dest)

        with lock:
            state["n"] += 1
            state["done"] += 1
            print("  [%3d/%d] %s" % (state["n"], total, stem))

    rc = 0
    try:
        with ThreadPoolExecutor(max_workers=args.jobs) as pool:
            list(pool.map(work, tracks))
    except KeyboardInterrupt:
        for p in list(inflight):
            try:
                os.remove(p)
            except OSError:
                pass
        sys.stderr.write(_("interrupted"))
        rc = 130
    finally:
        cover.close()

    if rc == 0:
        print(_("summary", state["done"], state["skipped"],
                len(state["failed"])))
        for title, why in state["failed"]:
            sys.stderr.write(_("failed_line", title, why))
        print(_("directory", os.path.abspath(args.out)))
        if state["failed"]:
            rc = 1
    return rc


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
PYTHON_EOF
