#!/usr/bin/env bash
#
# cnc_trackexport - Exports the soundtrack of the "Command & Conquer
#                   Remastered Collection" as tagged MP3s (or FLAC/WAV).
#
# Requires your own installation of the game.  No game data is shipped with
# it.  For personal use only.
#
set -euo pipefail

# Which language to speak.  English is the base and the fallback; a
# translation is used only where the locale asks for one and it exists.
ui_lang() {
    local tag="${LC_ALL:-${LC_MESSAGES:-${LANG:-${LANGUAGE:-}}}}"
    tag="${tag%%:*}"; tag="${tag%%.*}"; tag="${tag%%_*}"
    case "$(printf %s "$tag" | tr "A-Z" "a-z")" in
        de) echo de ;;
        *)  echo en ;;
    esac
}

usage_en() {
