#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""A rebuild of the Command & Conquer Remastered Collection music jukebox.

Requires your own installation of the game; it ships no game content.
Linux only.
"""

import argparse
import os
import sys

os.environ.setdefault("PYTHONUTF8", "1")


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("-g", "--game", help="game directory (default: autodetected)")
    ap.add_argument("-l", "--lang", help="EN-US, DE-DE, ... (default: system locale)")
    ap.add_argument("-s", "--skin", default=None,
                    choices=("soviet", "allied", "td"),
                    help="which jukebox skin (default: the one last chosen)")
    ap.add_argument("--fullscreen", action="store_true")
    ap.add_argument("--write-icon", metavar="PATH",
                    help="render the application icon to PATH and exit")
    ap.add_argument("--launcher-button", action="store_true",
                    help="show only the Jukebox row, drawn onto the bottom of "
                         "the game's own launcher (see tools/steam-launch-wrapper)")
    ap.add_argument("--launcher-pid", type=int, default=0,
                    help="close the row when this process exits, whether or "
                         "not the launcher window was ever found")
    args = ap.parse_args()

    try:
        from PyQt5.QtWidgets import QApplication, QMessageBox
    except ImportError:
        sys.stderr.write(
            "PyQt5 is required.\n"
            "  Debian/Ubuntu: sudo apt install python3-pyqt5\n"
            "  Fedora:        sudo dnf install python3-qt5\n"
            "  Arch:          sudo pacman -S python-pyqt5\n")
        return 1

    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    from jukebox.gamedata import GameData, GameDataError

    app = QApplication(sys.argv)
    app.setApplicationName("cnc-jukebox")

    try:
        data = GameData(args.game, args.lang)
    except GameDataError as e:
        # stderr first: a console user should see this even while the modal
        # dialog is still waiting to be dismissed.
        sys.stderr.write("Error: %s\n" % e)
        sys.stderr.flush()
        QMessageBox.critical(None, "C&C Jukebox", str(e))
        return 1

    from jukebox.ui import JukeboxWindow, stored_skin

    args.skin = args.skin or stored_skin()

    if args.write_icon:
        # Drawn from the game's own emblem, so it needs a window to build it.
        from PyQt5.QtCore import QSize
        win = JukeboxWindow(data, args.skin)
        pm = win.windowIcon().pixmap(QSize(256, 256))
        os.makedirs(os.path.dirname(os.path.abspath(args.write_icon)), exist_ok=True)
        return 0 if pm.save(args.write_icon) else 1

    if args.launcher_button:
        from PyQt5.QtCore import QTimer
        from PyQt5.QtGui import QFontDatabase
        from jukebox.assets import Atlas
        from jukebox.icon import pixmap as icon_pixmap
        from jukebox.launcher import LauncherArt, LauncherPanel
        from jukebox.ui import ACCENT, FONTS, SKIN_ORDER, TRACK_ICON

        atlas = Atlas(data.textures)
        icons = [icon_pixmap(256, atlas.sprite(
                     TRACK_ICON["Tiberian_Dawn" if s == "td" else "Red_Alert"]),
                     ACCENT[s])
                 for s in ("td",) + tuple(s for s in SKIN_ORDER if s != "td")]
        fid = QFontDatabase.addApplicationFontFromData(
            data.config.get(FONTS["orbitron"]) or b"")
        fams = QFontDatabase.applicationFontFamilies(fid) if fid != -1 else []

        panel = LauncherPanel(LauncherArt(data.game_dir), icons,
                              fams[0] if fams else "DejaVu Sans")
        holder = {}

        def open_jukebox():
            win = holder.get("win")
            if win is not None and win.isVisible():
                win.raise_()
                win.activateWindow()
                return
            win = JukeboxWindow(data, args.skin)
            holder["win"] = win
            win.show()

        def stand_down():
            """The launcher is gone.  So is this - but not a playing jukebox."""
            panel.stop_following()
            panel.close()
            win = holder.get("win")
            if win is None or not win.isVisible():
                app.quit()

        # The wrapper that started this exits when the game does.  Watching it
        # covers the case where the launcher was never found, so the strip can
        # never outlive the session that asked for it.
        if args.launcher_pid:
            def watch_parent():
                try:
                    os.kill(args.launcher_pid, 0)
                except OSError:
                    stand_down()
            keeper = QTimer()
            keeper.setInterval(1000)
            keeper.timeout.connect(watch_parent)
            keeper.start()

        panel.clicked.connect(open_jukebox)
        panel.launcherGone.connect(stand_down)
        # Nothing is shown until the launcher's window is actually on screen,
        # so the strip never appears on its own for a moment first.
        panel.follow_launcher()
        app.setQuitOnLastWindowClosed(True)
        return app.exec_()

    win = JukeboxWindow(data, args.skin)
    win.showFullScreen() if args.fullscreen else win.show()
    return app.exec_()


if __name__ == "__main__":
    sys.exit(main())
